# Copy to .env (gitignored). Values for running the API/worker on your machine with `uv run`.
DATABASE_URL=postgresql://ai:ai@localhost:5433/vectors
REDIS_URL=redis://localhost:6379

# Object storage (RustFS, S3 API). Connected mode: the backend's local RustFS. Standalone: http://localhost:9100
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=insighthub          # must match the backend's bucket
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin123

# Auth: tokens come from the backend's Keycloak (local, or the shared dev server)
AUTH_ISSUER=http://localhost:8180/realms/insighthub
AUTH_JWKS_URL=http://localhost:8180/realms/insighthub/protocol/openid-connect/certs
AUTH_AUDIENCE=insighthub-ai-service
AUTH_ALLOWED_CLIENT=insighthub-ai-caller

# This service's own client for calling back the backend (ADR-0003)
BACKEND_CALLBACK_URL=http://localhost:8080
CALLBACK_CLIENT_ID=insighthub-ai-callback
CALLBACK_CLIENT_SECRET=dev-only-change-me

# Models (fully local). No GPU? use the shared dev GPU server.
OLLAMA_URL=http://localhost:11434
LLM_MODEL=          # to decide (spec Section 11)
EMBEDDING_MODEL=bge-m3    # 1024 dimensions, see ADR-0005

# Web search fallback (provider to decide)
WEB_SEARCH_API_KEY=
